# Frontend environment variables (Vite).
# Copy to .env.local for local overrides. Only VITE_-prefixed variables are
# exposed to the browser bundle -- never put a secret in this file.

VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_APP_NAME="MarketPulse AI"

# Landing page contact form. International format, digits only, no "+"
# (for example 919876543210). Public contact detail, not a secret.
# Leave empty and the form reports that messaging is unconfigured.
VITE_WHATSAPP_NUMBER=

# Vercel: Root Directory=frontend, Node=24.x. Set before BUILD, then redeploy:
# VITE_API_BASE_URL=https://YOUR-BACKEND.onrender.com
# Include /api only if the backend API_PREFIX is /api.
# All VITE_ values are public. Never add JWT, database or provider secrets.
# Vite reads frontend/.env* (not the repository-root .env by default).
