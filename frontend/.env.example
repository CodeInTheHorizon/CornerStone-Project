# Frontend environment variables (Vite).
# Copy to .env.local for local overrides. Only VITE_-prefixed variables are
# exposed to the browser bundle -- never put a secret in this file.

VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_APP_NAME="MarketPulse AI"

# Landing page contact form. International format, digits only, no "+"
# (for example 919876543210). Public contact detail, not a secret.
# Leave empty and the form reports that messaging is unconfigured.
VITE_WHATSAPP_NUMBER=
