# ---------------------------------------------------------------------------
# MarketPulse AI -- environment configuration
# Copy to .env and adjust. Never commit a real .env file.
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME="MarketPulse AI API"
APP_VERSION=0.1.0
ENVIRONMENT=development
# Use true/false. Legacy shell DEBUG=release maps to false; debug maps to true.
# Non-development environments require false.
DEBUG=false
# Empty keeps routes at /auth/..., /data/..., matching the API outline in
# PROJECT_CONTEXT.md section 15. Set to "/api" to namespace them.
API_PREFIX=

# --- Server ---
HOST=127.0.0.1
PORT=8000

# --- Database ---
# Left unset on purpose: the application then defaults to an absolute
# path at <repo-root>/data/marketpulse.db, so the same database is used
# no matter which directory you launch the server from. A relative
# sqlite:/// URL resolves against the current working directory and will
# silently create a second database if you switch directories.
#
# SQLite, explicit absolute path:
# DATABASE_URL=sqlite:////absolute/path/to/marketPulse_AI/data/marketpulse.db
# PostgreSQL (production / Render):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/marketpulse
SQL_ECHO=false

# --- Authentication ---
# Outside development, use a random secret of at least 32 bytes. Empty/default
# secrets and DEBUG=true are rejected. Never put this value in a VITE_ variable.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
# 12 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- CORS ---
# Exact HTTP(S) frontend origins, comma-separated or a JSON array. No wildcard.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Frontend (Vite). Only VITE_-prefixed variables reach the browser bundle,
# so never place a secret here.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_APP_NAME="MarketPulse AI"
# Landing page contact form. International format, digits only, no "+".
# A public contact detail, not a secret. Leave empty to disable the form,
# which then says so plainly instead of opening a broken link.
VITE_WHATSAPP_NUMBER=

# --- Model training minimums (Phase 12) ---
# Below any of these, /ml/train returns insufficient_data instead of fitting.
# Counts are after leakage-safe labelling (see docs/PHASE_12_REPORT.md).
ML_MIN_LABELLED_ROWS=100
ML_MIN_TRAINING_ROWS=60
ML_MIN_VALIDATION_ROWS=20
ML_MIN_UNIQUE_PRODUCTS=10
# At least 4: each side of the time split needs two dates to label anything.
ML_MIN_OBSERVATION_DATES=4
ML_MIN_ROWS_PER_CLASS=5

# --- Marketplace collection ---
# Full provider findings: docs/MARKETPLACE_SOURCES.md.
# DataForSEO Merchant Amazon Products Live. Enabling permits paid requests.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
AMAZON_LIVE_ENABLED=false
DATAFORSEO_TIMEOUT_SECONDS=20

# Amazon public search-page collector. Parses search results from amazon.in
# (or another domain) using only HTTP + regex — no API key needed. Off by
# default: Amazon's Conditions of Use restrict automated collection, so
# enabling this is an explicit operator decision. When enabled, it replaces
# DataForSEO as the Amazon provider.
AMAZON_WEB_ENABLED=false
AMAZON_WEB_DOMAIN=www.amazon.in
AMAZON_WEB_CURRENCY=INR
AMAZON_WEB_LOCALE=en-IN
AMAZON_WEB_TIMEOUT_SECONDS=15

# Reserved approved-provider slots; these never enable scraping.
CROMA_PROVIDER_ENABLED=false
CROMA_PROVIDER_BASE_URL=
CROMA_PROVIDER_API_KEY=
ALIBABA_PROVIDER_ENABLED=false
ALIBABA_PROVIDER_BASE_URL=
ALIBABA_PROVIDER_API_KEY=
#
# Flipkart Affiliate API (the only LIVE connector). Backend environment only:
# never VITE_-prefixed, never committed. Get the ID and token from an approved
# Flipkart Affiliate account (API > API Token); one token per account, and
# generating a new token disables the old one.
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
# Keep false until Flipkart has confirmed in writing that storing its data as
# price history, cross-marketplace analytics and model training are permitted.
# Flipkart's API terms restrict use to its own platform. Credentials alone do
# not enable collection.
FLIPKART_DATA_USE_APPROVED=false
# Per-request timeout in seconds (1-60).
FLIPKART_TIMEOUT_SECONDS=15

# Amazon: PA-API 5.0 was retired on 15 May 2026. Its replacement (Creators API)
# needs 10 qualified sales per 30 days, and Amazon's policies forbid aggregating
# or analysing its data, seller tools and ML training without written approval.
# These legacy settings no longer enable anything and are kept for reference.
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=
AMAZON_PAAPI_HOST=webservices.amazon.in
AMAZON_PAAPI_REGION=eu-west-1
AMAZON_PAAPI_MARKETPLACE=www.amazon.in

# Croma and Alibaba take no configuration: Croma blocks programmatic access and
# has no public API; Alibaba's robots rules disallow search and its Open API is
# seller-only. Each reports its verified reason.

# --- Phase 10 deployment ---
# Full instructions: docs/DEPLOYMENT.md. These examples contain no production secrets.
# Render: ENVIRONMENT=production, DEBUG=false, SQL_ECHO=false, HOST=0.0.0.0
# PORT is injected by Render; app.start reads it. Do not hardcode it there.
LOG_LEVEL=INFO
ACCESS_LOG=false
# Set this on Render to YOUR exact Vercel production origin (no trailing slash):
# CORS_ORIGINS=https://YOUR-FRONTEND.vercel.app
# Optional explicit local origins can be appended; never allow *.vercel.app.
# JWT_SECRET_KEY must be generated privately; never deploy the development value.
# Local filesystem remains in use. Paths alone do NOT make storage durable:
# DATA_DIR=/absolute/writable/data
# MODEL_ARTIFACT_DIR=/absolute/writable/models
# DATABASE_URL=sqlite:////absolute/writable/data/marketpulse.db
# No database or artifact migration is performed by this phase.

# --- Phase 10.5 durable storage (supersedes the Phase 10 local-production example) ---
# auto = local in development, database otherwise. Production rejects local/SQLite.
STORAGE_BACKEND=auto
# Per binary object, 128 MiB by default; bounded in-memory serialization/read.
STORAGE_MAX_BYTES=134217728
# Production requires a managed/durable PostgreSQL database, configured privately:
# ENVIRONMENT=production
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/marketpulse?sslmode=require
# STORAGE_BACKEND=database
# postgres:// and postgresql:// URLs normalize to the installed psycopg driver.
# Dataset CSV + metadata and model binaries + metadata persist in stored_objects.
# DATA_DIR and MODEL_ARTIFACT_DIR remain the local-development roots only.
# No S3 credentials or new model upload route is needed.

# --- Phase 13 inbound abuse controls ---
# Per minute, except TRAIN (per hour). Positive values only; no bypass switch.
# One process/instance. See docs/PHASE_13_REPORT.md for proxy/IP limitations.
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=3
RATE_LIMIT_PREDICT=30
RATE_LIMIT_COLLECT=5
RATE_LIMIT_BUILD=5
RATE_LIMIT_IMPORT=5
RATE_LIMIT_DEMO=5
RATE_LIMIT_TRAIN=2
# Total HTTP body, before parsing; import includes multipart overhead.
REQUEST_MAX_BYTES=1048576
IMPORT_REQUEST_MAX_BYTES=6291456
# Uploaded files still have a separate fixed 5 MiB / 5,000-row limit.
