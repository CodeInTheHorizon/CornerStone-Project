# ---------------------------------------------------------------------------
# MarketPulse AI -- environment configuration
# Copy to .env and adjust. Never commit a real .env file.
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME="MarketPulse AI API"
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api

# --- Server ---
HOST=127.0.0.1
PORT=8000

# --- Database ---
# SQLite (default, local development):
DATABASE_URL=sqlite:///./data/marketpulse.db
# PostgreSQL (production / Render):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/marketpulse
SQL_ECHO=false

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Frontend (Vite). Only VITE_-prefixed variables reach the browser bundle,
# so never place a secret here.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_APP_NAME="MarketPulse AI"

# ---------------------------------------------------------------------------
# Added in later phases -- listed for visibility, unused in Phase 1.
# ---------------------------------------------------------------------------
# Phase 3 (authentication)
# JWT_SECRET_KEY=change-me-to-a-long-random-string
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60

# Phase 2 (landing page contact form -- public, not a secret)
# VITE_WHATSAPP_NUMBER=91XXXXXXXXXX

# Phase 4 (marketplace collection; use official API credentials only)
# AMAZON_PAAPI_ACCESS_KEY=
# AMAZON_PAAPI_SECRET_KEY=
# AMAZON_PAAPI_PARTNER_TAG=
